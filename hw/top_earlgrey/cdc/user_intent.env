# MeridianCDC user intent file

# Pad attributes are supposed to be stable during I/O operation.
set_stable_value [get_pins top_earlgrey/u_pinmux_aon/dio_pad_attr_q_reg*\[invert\]/Q]
set_stable_value [get_pins top_earlgrey/u_pinmux_aon/dio_pad_attr_q_reg*\[input_disable\]/Q]
set_stable_value [get_pins top_earlgrey/u_pinmux_aon/mio_pad_attr_q_reg*\[invert\]/Q]
set_stable_value [get_pins top_earlgrey/u_pinmux_aon/mio_pad_attr_q_reg*\[input_disable\]/Q]

# Pinmux input and output selectors are supposed to be stable during I/O operation.
set_stable_value [get_pins -regexp {top_earlgrey/u_pinmux_aon/u_reg/u_mio_periph_insel_[0-9]+/q_reg\[[0-9]*\]/Q}]
set_stable_value [get_pins -regexp {top_earlgrey/u_pinmux_aon/u_reg/u_mio_outsel_[0-9]+/q_reg\[[0-9]*\]/Q}]

# Wakeup detector pad selection is stable while the feature is actively being used (in sleep mode).
set_stable_value [get_pins top_earlgrey/u_pinmux_aon/u_reg/u_wkup_detector_padsel*/q*/Q]

# TAP straps are supposed to be stable during TAP operation.
set_stable_value [get_pins top_earlgrey/u_pinmux_aon/u_pinmux_strap_sampling/tap_strap_q_reg*/Q]

# Buffered OTP partitions are stable once OTP is initialized.
set_stable_value [get_pins top_earlgrey/u_otp_ctrl/gen_partitions*.gen_buffered.u_part_buf/dout_locked_q_reg*/Q]
set_stable_value [get_pins top_earlgrey/u_otp_ctrl/gen_partitions*.gen_buffered.u_part_buf/u_otp_ctrl_ecc_reg/data_q_reg*/Q]
